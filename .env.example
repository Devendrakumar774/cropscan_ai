# ==============================================================
# CropScan AI - Environment Variables Template
# Copy this file to .env.local for local development.
# Configure these variables in the Vercel Project Settings > Environment Variables.
# ==============================================================

# 1. Google Gemini AI API Key (Required for /api/analyze)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Gemini AI Models (Optional, defaults to flash models with automatic fallback)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# 3. Supabase Project Configuration (Required for cloud storage, scan history & auth)
# Get your Project URL and Anon Key from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

